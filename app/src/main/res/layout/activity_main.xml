<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootFrame"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_mesh_gradient">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingHorizontal="16dp"
        android:paddingTop="34dp"
        android:paddingBottom="18dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="96dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:shadowColor="#CC26F5FF"
                    android:shadowDx="0"
                    android:shadowDy="0"
                    android:shadowRadius="12"
                    android:text="Calcula para Jugar"
                    android:textColor="#FFDCD6FF"
                    android:textSize="32sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvMascotStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="-2dp"
                    android:gravity="center"
                    android:text="Neuri está dormido"
                    android:textColor="#FF9CFBFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <ImageView
                android:id="@+id/imgMascotHeader"
                android:layout_width="1dp"
                android:layout_height="1dp"
                android:alpha="0"
                android:contentDescription="Neuri"
                android:src="@drawable/mascot_stage_1" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSettings"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_gravity="end|top"
                android:background="@drawable/bg_glass_button_secondary"
                android:contentDescription="Ajustes"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text=""
                app:backgroundTint="@null"
                app:cornerRadius="21dp"
                app:icon="@drawable/ic_ui_settings"
                app:iconGravity="textStart"
                app:iconPadding="0dp"
                app:iconTint="@null"
                app:strokeWidth="0dp" />

        </FrameLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="360dp"
            android:layout_marginTop="4dp">

            <LinearLayout
                android:layout_width="128dp"
                android:layout_height="92dp"
                android:layout_gravity="start|top"
                android:layout_marginTop="38dp"
                android:background="@drawable/bg_cyber_stat_left"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="NIVEL"
                    android:textColor="#FF9CFBFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvLevel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1"
                    android:textColor="#FFC6FFFF"
                    android:textSize="36sp"
                    android:textStyle="bold" />

                <ProgressBar
                    android:id="@+id/progressLevel"
                    style="@android:style/Widget.ProgressBar.Horizontal"
                    android:layout_width="70dp"
                    android:layout_height="6dp"
                    android:max="100"
                    android:progress="0"
                    android:progressBackgroundTint="#4D4DF5FF"
                    android:progressTint="#FF66F7FF" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="128dp"
                android:layout_height="92dp"
                android:layout_gravity="end|top"
                android:layout_marginTop="38dp"
                android:background="@drawable/bg_cyber_stat_right"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="RACHA"
                    android:textColor="#FF9CFBFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvStreak"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:drawableEnd="@drawable/ic_ui_streak"
                    android:drawablePadding="4dp"
                    android:text="0"
                    android:textColor="#FFC6FFFF"
                    android:textSize="36sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="128dp"
                android:layout_height="92dp"
                android:layout_gravity="start|bottom"
                android:layout_marginBottom="86dp"
                android:background="@drawable/bg_cyber_stat_left"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="XP"
                    android:textColor="#FF9CFBFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvXp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0/50"
                    android:textColor="#FFC6FFFF"
                    android:textSize="22sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="128dp"
                android:layout_height="92dp"
                android:layout_gravity="end|bottom"
                android:layout_marginBottom="86dp"
                android:background="@drawable/bg_cyber_stat_right"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="HOY"
                    android:textColor="#FF9CFBFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tvTodayCorrect"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="#FFC6FFFF"
                        android:textSize="28sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="/"
                        android:textColor="#FF66F7FF"
                        android:textSize="24sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvTodayIncorrect"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="#FFC6FFFF"
                        android:textSize="28sp"
                        android:textStyle="bold" />
                </LinearLayout>

            </LinearLayout>

            <FrameLayout
                android:layout_width="220dp"
                android:layout_height="220dp"
                android:layout_gravity="center|top"
                android:layout_marginTop="42dp"
                android:background="@drawable/bg_cyber_orb">

                <ImageView
                    android:id="@+id/imgMascotBig"
                    android:layout_width="148dp"
                    android:layout_height="148dp"
                    android:layout_gravity="center"
                    android:contentDescription="Neuri"
                    android:src="@drawable/mascot_stage_1" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvMascotTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:shadowColor="#CC26F5FF"
                    android:shadowDx="0"
                    android:shadowDy="0"
                    android:shadowRadius="10"
                    android:text="Neuri - Despierto"
                    android:textColor="#FF9CFBFF"
                    android:textSize="30sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvMascotEvolution"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Evoluciona en 2 niveles"
                    android:textColor="#FF86F8FF"
                    android:textSize="17sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_cyber_panel"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp">

            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_cyber_orb"
                android:padding="14dp"
                android:src="@drawable/ic_ui_apps"
                android:contentDescription="Apps" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Apps monitoreadas"
                    android:textColor="@color/text_primary"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvBlockedCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ninguna app seleccionada"
                    android:textColor="#FF9CFBFF"
                    android:textSize="15sp" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSelectApps"
                android:layout_width="130dp"
                android:layout_height="50dp"
                android:background="@drawable/bg_cyber_action"
                android:text="Seleccionar"
                android:textAllCaps="false"
                android:textColor="#FF061222"
                android:textSize="13sp"
                android:textStyle="bold"
                app:backgroundTint="@null"
                app:cornerRadius="25dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLearn"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_cyber_action"
                android:text="Aprender"
                android:textAllCaps="false"
                android:textColor="#FF061222"
                android:textStyle="bold"
                app:backgroundTint="@null"
                app:cornerRadius="27dp"
                app:icon="@drawable/ic_ui_book"
                app:iconTint="@null" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStats"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_cyber_action_secondary"
                android:text="Progreso"
                android:textAllCaps="false"
                android:textColor="#FFC6FFFF"
                android:textStyle="bold"
                app:backgroundTint="@null"
                app:cornerRadius="27dp"
                app:icon="@drawable/ic_ui_streak"
                app:iconTint="@null" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_cyber_panel"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp">

            <ImageView
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="@drawable/bg_cyber_orb"
                android:contentDescription="Tabla periódica"
                android:padding="12dp"
                android:src="@drawable/ic_ui_book" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tabla periódica"
                    android:textColor="@color/text_primary"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Explora los 118 elementos"
                    android:textColor="#FF9CFBFF"
                    android:textSize="15sp" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPeriodicTable"
                android:layout_width="130dp"
                android:layout_height="50dp"
                android:background="@drawable/bg_cyber_action"
                android:text="Explorar"
                android:textAllCaps="false"
                android:textColor="#FF061222"
                android:textSize="13sp"
                android:textStyle="bold"
                app:backgroundTint="@null"
                app:cornerRadius="25dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_cyber_panel"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Intervalo de preguntas"
                    android:textColor="@color/text_primary"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvIntervalValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:gravity="end"
                    android:maxLines="1"
                    android:text="Cada 5 minutos"
                    android:textColor="#FFC6FFFF"
                    android:textSize="15sp" />
            </LinearLayout>

            <com.google.android.material.slider.Slider
                android:id="@+id/sliderInterval"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:valueFrom="1"
                android:valueTo="30"
                android:stepSize="1"
                app:haloColor="#5531F5E8"
                app:thumbColor="#FF31F5E8"
                app:trackColorActive="#FF31F5E8"
                app:trackColorInactive="#5531F5E8" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_cyber_category"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Categorías"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupCategory"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:singleSelection="false">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipMath"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="true"
                    android:text="Matemáticas"
                    android:textColor="@color/chip_text_selector"
                    app:chipBackgroundColor="@color/chip_bg_selector"
                    app:chipIcon="@drawable/ic_cat_math"
                    app:chipIconTint="@null"
                    app:chipIconVisible="true"
                    app:chipStrokeColor="@color/chip_stroke_selector"
                    app:chipStrokeWidth="1dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipEnglish"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="true"
                    android:text="Inglés"
                    android:textColor="@color/chip_text_selector"
                    app:chipBackgroundColor="@color/chip_bg_selector"
                    app:chipIcon="@drawable/ic_cat_english"
                    app:chipIconTint="@null"
                    app:chipIconVisible="true"
                    app:chipStrokeColor="@color/chip_stroke_selector"
                    app:chipStrokeWidth="1dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipPython"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="true"
                    android:text="Python"
                    android:textColor="@color/chip_text_selector"
                    app:chipBackgroundColor="@color/chip_bg_selector"
                    app:chipIcon="@drawable/ic_cat_python"
                    app:chipIconTint="@null"
                    app:chipIconVisible="true"
                    app:chipStrokeColor="@color/chip_stroke_selector"
                    app:chipStrokeWidth="1dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipCuriosidades"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="true"
                    android:text="Curiosidades"
                    android:textColor="@color/chip_text_selector"
                    app:chipBackgroundColor="@color/chip_bg_selector"
                    app:chipIcon="@drawable/ic_cat_curiosidades"
                    app:chipIconTint="@null"
                    app:chipIconVisible="true"
                    app:chipStrokeColor="@color/chip_stroke_selector"
                    app:chipStrokeWidth="1dp" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipPeriodicTable"
                    style="@style/Widget.MaterialComponents.Chip.Choice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checkable="true"
                    android:text="Tabla periódica"
                    android:textColor="@color/chip_text_selector"
                    app:chipBackgroundColor="@color/chip_bg_selector"
                    app:chipIcon="@drawable/ic_ui_book"
                    app:chipIconTint="@null"
                    app:chipIconVisible="true"
                    app:chipStrokeColor="@color/chip_stroke_selector"
                    app:chipStrokeWidth="1dp" />
            </com.google.android.material.chip.ChipGroup>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_cyber_console"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingVertical="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStartService"
                android:layout_width="0dp"
                android:layout_height="58dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_cyber_action"
                android:text="Activar"
                android:textAllCaps="false"
                android:textColor="#FF061222"
                android:textSize="18sp"
                android:textStyle="bold"
                app:backgroundTint="@null"
                app:cornerRadius="29dp"
                app:icon="@drawable/ic_ui_bolt"
                app:iconGravity="textStart"
                app:iconPadding="8dp"
                app:iconTint="@null"
                app:strokeWidth="0dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStopService"
                android:layout_width="0dp"
                android:layout_height="58dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_cyber_action_secondary"
                android:text="Desactivar"
                android:textAllCaps="false"
                android:textColor="#FFC6FFFF"
                android:textSize="16sp"
                android:textStyle="bold"
                app:backgroundTint="@null"
                app:cornerRadius="29dp"
                app:strokeWidth="0dp" />

            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPauseService"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_cyber_action_secondary"
                android:text="Pausar preguntas 30 minutos"
                android:textAllCaps="false"
                android:textColor="#FFC6FFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                app:backgroundTint="@null"
                app:cornerRadius="24dp"
                app:strokeWidth="0dp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>

</FrameLayout>
