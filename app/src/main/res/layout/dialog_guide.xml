<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minWidth="300dp"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_glass_card"
        android:orientation="vertical"
        android:padding="22dp">

        <ImageView
            android:id="@+id/imgGuideIcon"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/bg_glass_button_secondary"
            android:contentDescription="Guia"
            android:padding="12dp"
            android:src="@drawable/ic_ui_apps" />

        <TextView
            android:id="@+id/tvGuideStep"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="1 de 5"
            android:textColor="@color/primary"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvGuideTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Guia rapida"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvGuideBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:lineSpacingExtra="3dp"
            android:textColor="@color/text_secondary"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGuideBack"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_glass_button_secondary"
                android:minWidth="0dp"
                android:text="Atras"
                android:textAllCaps="false"
                android:textColor="@color/text_secondary"
                app:backgroundTint="@null"
                app:cornerRadius="14dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGuideNext"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:background="@drawable/bg_glass_button"
                android:minWidth="0dp"
                android:text="Siguiente"
                android:textAllCaps="false"
                android:textColor="@color/black"
                android:textStyle="bold"
                app:backgroundTint="@null"
                app:cornerRadius="14dp" />

        </LinearLayout>

    </LinearLayout>

</FrameLayout>
