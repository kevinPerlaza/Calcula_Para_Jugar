<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#3D8B7CF6" />
            <corners android:radius="32dp" />
        </shape>
    </item>

    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:startColor="#F01D294D"
                android:centerColor="#E6162140"
                android:endColor="#D9151B35"
                android:type="linear" />
            <corners android:radius="31dp" />
        </shape>
    </item>
</layer-list>
