<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#5531F5E8" />
            <corners android:radius="30dp" />
        </shape>
    </item>
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="#9910203D"
                android:centerColor="#AA132B4F"
                android:endColor="#991E1646"
                android:type="linear" />
            <corners android:radius="29dp" />
            <stroke android:width="1dp" android:color="#AA55F4FF" />
        </shape>
    </item>
</layer-list>
