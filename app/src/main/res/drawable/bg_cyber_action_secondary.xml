<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#804DF5FF" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="#55152548"
                android:endColor="#77311C64"
                android:type="linear" />
            <corners android:radius="22dp" />
            <stroke android:width="1dp" android:color="#CC5FF8FF" />
        </shape>
    </item>
</layer-list>
