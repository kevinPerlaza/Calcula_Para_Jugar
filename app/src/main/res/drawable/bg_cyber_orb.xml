<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="#666B5CE7" />
        </shape>
    </item>
    <item android:left="5dp" android:top="5dp" android:right="5dp" android:bottom="5dp">
        <shape android:shape="oval">
            <gradient
                android:centerColor="#8D9B8CFF"
                android:endColor="#332B3F86"
                android:gradientRadius="96dp"
                android:type="radial" />
            <stroke android:width="2dp" android:color="#C6B9AFFF" />
        </shape>
    </item>
</layer-list>
