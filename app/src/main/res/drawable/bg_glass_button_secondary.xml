<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#2DFFFFFF"
                android:centerColor="#1A303A5E"
                android:endColor="#2B8B7CF6"
                android:type="linear" />
            <corners android:radius="14dp" />
        </shape>
    </item>

    <item
        android:left="1dp"
        android:top="1dp"
        android:right="1dp"
        android:bottom="1dp">
        <shape android:shape="rectangle">
            <solid android:color="#C8121B35" />
            <corners android:radius="13dp" />
        </shape>
    </item>
</layer-list>
