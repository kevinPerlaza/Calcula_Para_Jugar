<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#4D8B7CF6" />
            <corners android:radius="26dp" />
        </shape>
    </item>

    <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="315"
                android:startColor="#E0182240"
                android:centerColor="#D9121B35"
                android:endColor="#E020183F"
                android:type="linear" />
            <corners android:radius="24dp" />
            <stroke android:width="1dp" android:color="#8A9F91FF" />
        </shape>
    </item>
</layer-list>
