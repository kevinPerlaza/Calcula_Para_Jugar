<?xml version="1.0" encoding="utf-8"?>
<!-- Liquid Glass card: subtle premium surface with a fine refractive edge. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="135"
                android:startColor="#35FFFFFF"
                android:centerColor="#162A3150"
                android:endColor="#1F8B7CF6"
                android:type="linear" />
            <corners android:radius="22dp" />
        </shape>
    </item>

    <item
        android:left="1dp"
        android:top="1dp"
        android:right="1dp"
        android:bottom="1dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:startColor="#E0182240"
                android:centerColor="#D7121B35"
                android:endColor="#EB0B1020"
                android:type="linear" />
            <corners android:radius="21dp" />
        </shape>
    </item>
</layer-list>
